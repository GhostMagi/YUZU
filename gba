#!/bin/bash
# One word to play. Starts the VNC desktop if it isn't up, launches the
# emulator into it, and tells you what to point AVNC at.
#
#   ~/YUZU/gba              newest ROM in ~/ROMs/gba
#   ~/YUZU/gba soul         newest ROM whose name contains "soul"
#
# Written because the real command was three lines with a DISPLAY
# prefix, a vncserver invocation and a glob -- none of which is
# something to retype on a phone keyboard.

set -u
ROMS="$HOME/ROMs/gba"
DISP=":1"
PORT=5901

# The address AVNC can actually reach. The board also lists a docker
# bridge and a USB-gadget link, and this project has lost time twice to
# picking the wrong one out of `hostname -I` -- so ask the routing
# table instead of guessing.
lan_ip() {
    local found
    found=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K\S+' | head -1)
    # Never return empty -- printing a bare ":5901" reads like a bug in
    # the script when it is really "this board is not on the network",
    # which is a different problem with a different fix.
    [ -n "$found" ] && echo "$found" || echo "<board is offline>"
}

if [ "${1:-}" = "--off" ]; then
    pkill -f mgba-qt 2>/dev/null
    vncserver -kill $DISP >/dev/null 2>&1
    echo "Emulator and desktop stopped."
    exit 0
fi

# Pick the ROM before starting anything, so a typo fails in a second
# instead of after a desktop has been spun up.
if [ $# -gt 0 ]; then
    ROM=$(ls -t "$ROMS"/*"$1"*.gba 2>/dev/null | head -1)
    [ -z "$ROM" ] && { echo "No ROM matching '$1' in $ROMS"; exit 1; }
else
    ROM=$(ls -t "$ROMS"/*.gba 2>/dev/null | head -1)
    [ -z "$ROM" ] && { echo "No .gba files in $ROMS yet."; \
        echo "Send one over:  cd $ROMS && python3 ~/YUZU/drop.py"; exit 1; }
fi

# The check is "can the PHONE reach it", not "is X running". Those came
# apart on the first real attempt: TigerVNC started fine, xdpyinfo was
# happy, and the server was bound to 127.0.0.1 -- listening only for
# connections from the board itself. AVNC could not connect and nothing
# on screen said why, because by every other measure it was working.
#
# So: look for a listener on $PORT that is NOT loopback.
reachable() {
    ss -ltn 2>/dev/null | awk -v port=":$PORT" '
        $4 ~ port"$" && $4 !~ /^127\./ && $4 !~ /^\[::1\]/ { found = 1 }
        END { exit !found }'
}

if ! reachable; then
    echo "Starting the desktop..."
    vncserver -kill $DISP >/dev/null 2>&1     # clears a stale lock; may fail
    # -localhost no is the whole fix. Without it TigerVNC binds to
    # loopback and every phone on the network is locked out.
    if ! vncserver $DISP -geometry 1280x720 -depth 24 -localhost no \
            > /tmp/vncstart.log 2>&1; then
        echo "vncserver would not start:"
        tail -5 /tmp/vncstart.log
        exit 1
    fi
    sleep 2                                   # it binds a moment after forking
    if ! reachable; then
        echo "The desktop started but is not reachable from the network."
        echo "What it is actually listening on:"
        ss -ltn | grep "$PORT" || echo "  nothing on port $PORT"
        exit 1
    fi
fi

# nohup + & so the emulator does NOT hold this terminal. A foreground
# process on a phone serial link looks exactly like a freeze, and that
# has already cost one power-cycle on this board.
nohup env DISPLAY=$DISP mgba-qt "$ROM" >/dev/null 2>&1 &

echo
echo "  Playing:  $(basename "$ROM")"
echo "  Open AVNC and connect to:  $(lan_ip):$PORT"
echo
echo "  Quit from inside mGBA, or stop everything with:  ~/YUZU/gba --off"
echo
