#!/bin/bash
# ~/YUZU/cube -- put Four, Yuzu, Zero, Saya and Rei on the StackChan cube.
#
#   1. Plug the cube into one of the board's USB-A ports.
#   2. Run:  ~/YUZU/cube
#
# Ghost, Oct 2: "can we put Four in it? Her art on the screen?" This is
# the one word that does it. Then, the same day: "Can you squeeze Yuzu
# on too?", then Zero, then Saya (Oct 22), then Rei with the cube's
# camera (Oct 30) -- so the cube carries all five, and a swipe moves
# between them. Run it
# again any time the cube code changes. It pulls the newest code itself
# first (Oct 22), so it never puts an old cube back on.
#
# WHAT IT DOES, in order, verdict first at every step:
#   - finds the cube on USB, before spending anything;
#   - pulls the newest code from GitHub, and flashes what the board
#     already has if there is no internet;
#   - reads EVERY WiFi the board has saved, its current one first, so
#     the cube joins whichever of them it can see -- home, or his
#     phone's hotspot (Oct 17). The passwords need sudo to read, which
#     is the one thing it asks;
#   - the first time only, fetches the build tools (~1.5 GB, said before
#     it starts) into ~/.yuzu/cube-tools, OUTSIDE the repo -- a repo
#     folder full of toolchain would block every pull, and Save my stuff
#     does not carry it, because it can always be fetched again;
#   - builds her in a TEMPORARY folder with the WiFi password in it, and
#     deletes that folder when it is done. His passwords are never written
#     inside this repository, which is on GitHub.
#
# The board's NAME (for mDNS) and its current numbers (the fallback) are
# read here, never typed in -- the ghostnano rule -- and a board named
# `localhost` gives no name at all, the refusal `face` and `pull` learned.
#
# UNVERIFIED ON HIS HARDWARE: the cube's USB name and the upload. Built
# and compiled for the CoreS3 in a container; never flashed onto one.

HERE="$(cd "$(dirname "$0")" && pwd)"
SKETCH="$HERE/stackchan/cube"
TOOLS="${YUZU_CUBE_TOOLS:-$HOME/.yuzu/cube-tools}"
CLI="${YUZU_CUBE_CLI:-$TOOLS/arduino-cli}"
CFG="$TOOLS/arduino-cli.yaml"
PORT_NUM="${YUZU_FACE_PORT:-8081}"
# The ESP32 core and M5 libraries her code was compiled against.
CORE_INDEX="https://github.com/espressif/arduino-esp32/releases/download/3.3.2/package_esp32_index.json"
CORE="esp32:esp32@3.3.2"
LIBS="M5Unified@0.2.25 M5GFX@0.2.32"
# PSRAM on, because her rain, her picture and every recording live
# there; the big-app layout, because she is 1.3 MB and the default
# leaves 1.2.
FQBN="esp32:esp32:m5stack_cores3:PSRAM=enabled,PartitionScheme=huge_app"
CLI_VERSION="1.3.1"

lan_ip() {
    local found
    found=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K\S+' | head -1)
    if [ -z "$found" ]; then
        found=$(hostname -I 2>/dev/null | tr ' ' '\n' \
                | grep -v '^127\.' | grep -v '^172\.1[6-9]\.' \
                | grep -v '^172\.2[0-9]\.' | grep -v '^172\.3[01]\.' \
                | grep -v '^192\.168\.55\.' | head -1)
    fi
    echo "$found"
}

board_name() {
    local name; name=$(hostname -s 2>/dev/null)
    case "$name" in
        localhost|localhost.*|*[!A-Za-z0-9-]*|"") name="" ;;
    esac
    echo "$name"
}

find_cube() {
    if [ -n "${YUZU_CUBE_SERIAL+x}" ]; then
        [ -e "$YUZU_CUBE_SERIAL" ] && echo "$YUZU_CUBE_SERIAL"
        return
    fi
    local dev
    for dev in /dev/serial/by-id/*Espressif* /dev/serial/by-id/*M5* /dev/ttyACM*; do
        [ -e "$dev" ] && { echo "$dev"; return; }
    done
}

# ---- 1. the cube --------------------------------------------------------
cube=$(find_cube)
if [ -z "$cube" ]; then
    echo "NO CUBE FOUND."
    echo "Plug it into one of the board's USB-A ports and run ~/YUZU/cube"
    echo "again. If it is plugged in: try another cable -- a charge-only"
    echo "cable powers it and shows the board nothing."
    exit 1
fi
echo "Found the cube at $cube."

no_usb() {
    echo "NOT FLASHED. The board isn't allowed to use the cube's USB yet."
    echo "Type these two, one at a time (the board restarts after the second):"
    echo "    sudo usermod -aG dialout \$USER"
    echo "    sudo reboot"
    echo "Then ~/YUZU/cube again. It won't download anything a second time."
}

# CHECKED HERE, before 1.5 GB of tools and minutes of building. His
# first real flash (Oct 17) did all of that and then failed on exactly
# this: his user was not in the group that may open a USB serial port,
# and esptool said so as "Path ... is not readable", which no line
# below knew to translate.
if [ ! -r "$cube" ] || [ ! -w "$cube" ]; then
    no_usb
    exit 1
fi

# ---- 1b. the newest code, first ----------------------------------------------
# MEASURED, Oct 22, off his screen: Saya went on the cube the night
# before, he flashed in the morning, and the cube came up without her.
# The flash WORKED -- its own DONE line said "Four, Yuzu and Zero", the
# old wording, so the BOARD had never pulled her down, and this built
# exactly what the board had. It flashed the old cube perfectly.
#
# So it pulls first, with the `pull` he already has. No internet (the
# garage, a cold clock) costs only the update: it says so and flashes
# what the board already has, which is what it always did.
#
# ONE `if`, PARSED WHOLE BEFORE IT RUNS. `git pull` can replace this
# very file while bash is reading it, and bash then carries on at the
# same byte offset in the NEW file -- the splice `pull` itself had to
# learn about. Nothing more of this file is read until the `if` ends,
# and a changed script is run again from its top. Keep it one block.
PULL="${YUZU_CUBE_PULL-$HERE/pull}"
if [ -z "${YUZU_CUBE_PULLED:-}" ] && [ -n "$PULL" ] && [ -f "$PULL" ]; then
    echo "Getting the newest version first (a minute on a cold board)..."
    was=$(cksum < "$0")
    out=$(bash "$PULL" 2>&1)
    case "$out" in
        *"UPDATED."*)      echo "  Updated." ;;
        *"UP TO DATE"*)    echo "  Already the newest." ;;
        *)  echo "  COULD NOT UPDATE, so this puts on what the board already has:"
            printf '%s\n' "$out" | grep -v '^ *$' | head -4 | sed 's/^/    /' ;;
    esac
    if [ "$(cksum < "$0")" != "$was" ]; then
        echo "  This script changed too, so running the new one."
        YUZU_CUBE_PULLED=1 exec bash "$0" "$@"
    fi
fi

# ---- 2. every WiFi the board knows -------------------------------------------
# Ghost, Oct 17: "i need it to be able to connect to my phones mobile
# hotspot". So the cube is given EVERY WiFi network the board has saved
# -- the one it is on first, then the rest -- and joins the first of
# them it can see. A network the board has never joined would be no use
# to her: the two have to be on the same one to find each other.
#
# By UUID, never by name: a name can hold a colon, and nmcli's terse
# output mangles one. And `-e no` on every value read, because terse
# mode otherwise ESCAPES ':' and '\' -- a password holding either would
# reach the cube with a backslash it never had.
nets=()     # ssid, password, ssid, password, ...
unread=()   # locked networks whose password could not be read
if [ -n "${YUZU_CUBE_SSID:-}" ]; then
    nets+=("$YUZU_CUBE_SSID" "${YUZU_CUBE_PASS:-}")
elif command -v nmcli >/dev/null 2>&1; then
    # The board's OWN WiFi (own_wifi.sh, Oct 22) goes straight after the
    # one it is on, so the cap of eight below can never drop it: it is
    # the only network the two can meet on where there is no other.
    uuids=$( { nmcli -t -f UUID,TYPE connection show --active 2>/dev/null
               nmcli -t -f UUID,TYPE,NAME connection show 2>/dev/null \
                   | awk -F: '$3=="yuzu-own-wifi"'
               nmcli -t -f UUID,TYPE connection show 2>/dev/null; } \
             | awk -F: '$2=="802-11-wireless" && !seen[$1]++ {print $1}')
    [ -n "$uuids" ] && echo "Reading the WiFi passwords the board has saved needs sudo:"
    for u in $uuids; do
        s=$(nmcli -e no -g 802-11-wireless.ssid connection show uuid "$u" 2>/dev/null)
        [ -z "$s" ] && continue
        known=""
        for ((i = 0; i < ${#nets[@]}; i += 2)); do
            [ "${nets[i]}" = "$s" ] && known=1
        done
        [ -n "$known" ] && continue
        pw=$(sudo nmcli -e no -s -g 802-11-wireless-security.psk \
             connection show uuid "$u" 2>/dev/null)
        # A locked network whose password came back empty is one the
        # cube cannot join -- a password kept in a desktop keyring, out
        # of sudo's reach. Said at flash time, never left to the cube to
        # fail at quietly on the day.
        lock=$(nmcli -e no -g 802-11-wireless-security.key-mgmt \
               connection show uuid "$u" 2>/dev/null)
        [ -n "$lock" ] && [ -z "$pw" ] && unread+=("$s")
        nets+=("$s" "$pw")
        [ ${#nets[@]} -ge 16 ] && break      # eight networks is plenty
    done
fi
if [ ${#nets[@]} -eq 0 ]; then
    echo "The board hasn't saved any WiFi I can read, so type it in."
    read -r -p "WiFi name: " ssid
    read -r -s -p "WiFi password: " pass
    echo
    [ -n "$ssid" ] && nets+=("$ssid" "$pass")
fi
if [ ${#nets[@]} -eq 0 ]; then
    echo "NOT FLASHED. The cube needs a WiFi name to find the board."
    exit 1
fi
echo "The cube will know these WiFi networks, and join the first it can see:"
for ((i = 0; i < ${#nets[@]}; i += 2)); do
    note=""
    for x in "${unread[@]}"; do
        [ "$x" = "${nets[i]}" ] && note="   <- I couldn't read its password, so she can't join it"
    done
    echo "    ${nets[i]}$note"
done
echo "(Your phone's hotspot not in that list? The board has never joined it."
echo " Turn the hotspot on, run this once, then ~/YUZU/cube again:"
echo "    sudo nmcli device wifi connect \"HOTSPOT NAME\" password \"PASSWORD\")"
echo "The cube only hears 2.4 GHz WiFi, so set your hotspot's band to 2.4 GHz."

name=$(board_name)
addr=$(lan_ip)
if [ -z "$name" ] && [ -z "$addr" ]; then
    echo "NOT FLASHED. The board has no name and no network address the"
    echo "cube could use. Is it on the WiFi?"
    exit 1
fi

# ---- 3. the build tools, once ----------------------------------------------
mkdir -p "$TOOLS"
if [ ! -x "$CLI" ]; then
    case "$(uname -m)" in
        aarch64|arm64) arch="Linux_ARM64" ;;
        x86_64)        arch="Linux_64bit" ;;
        *) echo "NOT FLASHED. This machine ($(uname -m)) has no build tools I know."; exit 1 ;;
    esac
    echo "FIRST TIME: fetching the build tools, about 1.5 GB, into $TOOLS."
    echo "Later flashes reuse them. This takes a while on WiFi."
    url="https://github.com/arduino/arduino-cli/releases/download/v$CLI_VERSION/arduino-cli_${CLI_VERSION}_$arch.tar.gz"
    if ! curl -fsSL "$url" -o "$TOOLS/cli.tar.gz.part"; then
        echo "NOT FLASHED. The build tools would not download -- is the"
        echo "board on the internet? (The cube itself never needs it.)"
        rm -f "$TOOLS/cli.tar.gz.part"
        exit 1
    fi
    tar -xzf "$TOOLS/cli.tar.gz.part" -C "$TOOLS" arduino-cli && rm -f "$TOOLS/cli.tar.gz.part"
fi
if [ ! -f "$CFG" ]; then
    cat > "$CFG" <<EOF
directories:
  data: $TOOLS/data
  downloads: $TOOLS/downloads
  user: $TOOLS/user
board_manager:
  additional_urls:
    - $CORE_INDEX
EOF
fi
cli() { "$CLI" --config-file "$CFG" "$@"; }
if ! cli core list 2>/dev/null | grep -q "^esp32:esp32 *3\.3\.2"; then
    echo "Installing the ESP32 core and the M5 libraries..."
    cli core update-index >/dev/null 2>&1
    if ! cli core install "$CORE" > "$TOOLS/install.log" 2>&1; then
        echo "NOT FLASHED. The ESP32 core would not install. Its own words:"
        tail -5 "$TOOLS/install.log"
        exit 1
    fi
fi
# Pinned to what she was compiled against; the latest if those are gone.
cli lib install $LIBS > "$TOOLS/libs.log" 2>&1 || cli lib install M5Unified M5GFX >> "$TOOLS/libs.log" 2>&1

# ---- 4. build her somewhere temporary, with the WiFi in it ----------------
build=$(mktemp -d /tmp/yuzu-cube.XXXXXX)
trap 'rm -rf "$build"' EXIT
cp -r "$SKETCH" "$build/cube"
python3 - "$build/cube/cube_secrets.h" "$name" "$addr" "$PORT_NUM" "${nets[@]}" <<'PY'
import sys
path, host, ip, port = sys.argv[1:5]
pairs = list(zip(sys.argv[5::2], sys.argv[6::2]))
def c(s):
    # A C string literal: backslashes and quotes escaped, nothing else
    # trusted -- a WiFi password can hold either.
    return '"' + "".join("\\x%02x" % b if b < 32 or b in (34, 92) or b > 126
                         else chr(b) for b in s.encode()) + '"'
with open(path, "w") as fh:
    fh.write("// Written by ~/YUZU/cube for one flash, then deleted.\n")
    # Every network the board knows, its own first: the cube joins the
    # first of them it can see.
    fh.write("#define CUBE_WIFI_COUNT %d\n" % len(pairs))
    fh.write("static const char* const CUBE_WIFI[CUBE_WIFI_COUNT][2] = {\n")
    for ssid, pw in pairs:
        fh.write("  {%s, %s},\n" % (c(ssid), c(pw)))
    fh.write("};\n")
    fh.write("#define CUBE_HOST %s\n" % c(host))
    fh.write("#define CUBE_HOST_IP %s\n" % c(ip))
    fh.write("#define CUBE_PORT %d\n" % int(port))
PY
# A cube built with no settings joins nothing, and says only "No WiFi"
# about a fault that is here. Stop where it happened.
if [ $? -ne 0 ] || [ ! -s "$build/cube/cube_secrets.h" ]; then
    echo "NOT FLASHED. I couldn't write the cube's WiFi settings."
    exit 1
fi

echo "Building her and putting her on the cube (a few minutes)..."
# --build-path keeps EVERYTHING the build makes inside the temporary
# folder -- arduino-cli's default copies the sketch, secrets and all,
# into /tmp/arduino/sketches/ and leaves it there.
if ! cli compile -b "$FQBN" --build-path "$build/out" --upload -p "$cube" \
        "$build/cube" > "$TOOLS/flash.log" 2>&1; then
    if grep -qiE "permission denied|is not readable|is not writable" "$TOOLS/flash.log"; then
        no_usb
    elif grep -qi "could not open" "$TOOLS/flash.log"; then
        echo "NOT FLASHED. The board couldn't open the cube's USB port."
        echo "Unplug the cube, plug it back in, and run ~/YUZU/cube again."
    elif grep -qiE "failed to connect|no serial data|timed out waiting" "$TOOLS/flash.log"; then
        echo "NOT FLASHED. The cube didn't answer. Hold its reset button for"
        echo "about three seconds (until a green light shows), then run"
        echo "~/YUZU/cube again."
    else
        echo "NOT FLASHED. The build's own words:"
        tail -8 "$TOOLS/flash.log"
    fi
    exit 1
fi

echo "DONE. Four, Yuzu, Zero, Saya and Rei are on the cube."
echo "It restarts by itself; give it about ten seconds to join your WiFi."
echo "Hold the screen to talk, let go to send. Swipe across it to change girls."
echo "On Rei, a tap takes a photo. You see it first: Send gives it to her, Retry takes another."
echo "Swipe past Rei for the ghost."
