#!/bin/bash
# Auto-tiling windows, one word.
#
#   ~/YUZU/tile            install and turn it on
#   ~/YUZU/tile --off      floating windows back (stays installed)
#   ~/YUZU/tile --remove   uninstall it
#   ~/YUZU/tile --status   is it on
#
# WHY: on a 10" 1024x600 panel, floating windows are the wrong model.
# Every window overlaps, every one needs dragging, and there is no room
# to waste on the parts you cannot see. Tiling hands the whole screen to
# whatever is open and splits it automatically -- her face, a terminal
# and Kiwix become three panes instead of three things to shuffle.
#
# POP SHELL WAS THE FIRST CHOICE AND IT IS NOT PACKAGED. Measured on the
# board, Sept 9: `E: Unable to locate package gnome-shell-extension-pop-
# shell`. It ships in Pop!_OS's repos, not Ubuntu's, and the claim that
# "Ubuntu ships it" was wrong. It is still tried first -- it is one apt
# line and costs two seconds -- and FORGE is the automatic fallback.
#
# FORGE INSTALLS WITHOUT A BROWSER. extensions.gnome.org has a JSON
# endpoint that names the right zip for a given GNOME version, so this
# asks it, downloads, and installs with `gnome-extensions install`. No
# store page, no GUI, no clicking on a 7" screen. That matters more here
# than which extension wins: his only shell is a serial cable.
#
# NOT INSTALLED BLIND. A GNOME extension can leave a desktop that will
# not draw, so `--off` is a SEPARATE word from `--remove` and gives him
# the ordinary desktop back without throwing the package away.

set -u
POP="pop-shell@system76.com"
FORGE="forge@jmmaranan.com"

# "Is GNOME Shell RUNNING", not "is it installed". Those come apart on
# this board: Ubuntu ships gnome-shell, but the desktop may be a bare X
# session from ~/.vnc/xstartup with no shell in it. Checking the package
# would say yes the whole time nothing was tiling -- the same shape as
# xdpyinfo answering happily through a loopback-only VNC bind.
on_gnome()        { pgrep -x gnome-shell >/dev/null 2>&1; }
gnome_installed() { command -v gnome-shell >/dev/null 2>&1; }

have() { command -v gnome-extensions >/dev/null 2>&1 \
         && gnome-extensions list 2>/dev/null | grep -q "$1"; }
live() { command -v gnome-extensions >/dev/null 2>&1 \
         && gnome-extensions list --enabled 2>/dev/null | grep -q "$1"; }

# Whichever one is actually here. Pop Shell first only because if both
# ever exist, it is the one that was asked for.
which_ext() {
    for e in "$POP" "$FORGE"; do have "$e" && { echo "$e"; return; }; done
}

say_state() {
    local ext; ext=$(which_ext)
    echo
    if [ -n "$ext" ] && live "$ext"; then
        echo "  ON.  Windows tile themselves."
        echo
        if [ "$ext" = "$POP" ]; then
            echo "  Super + Y        tiling on/off, live"
            echo "  Super + arrows   move between windows"
        else
            # Forge's own shortcuts are NOT stated here. They were not
            # verified on this board, and unverified keystrokes printed
            # as instructions already cost an hour on the 8BitDo -- they
            # send a person debugging their own hands. Name the goal.
            echo "  Its shortcuts are listed in Forge's own settings,"
            echo "  under Extensions on the desktop."
        fi
        echo
        echo "  Off any time, no desktop needed:  ~/YUZU/tile --off"
    elif [ -n "$ext" ]; then
        echo "  OFF (still installed).  Turn it on with:  ~/YUZU/tile"
    else
        echo "  NOT INSTALLED.  Install it with:  ~/YUZU/tile"
    fi
    echo
}

case "${1:-}" in
--status) say_state; exit 0 ;;
--off)
    ext=$(which_ext)
    [ -n "$ext" ] && gnome-extensions disable "$ext" 2>/dev/null \
        && echo "Tiling off. Windows float again." \
        || echo "It was not on."
    exit 0 ;;
--remove)
    ext=$(which_ext)
    [ -n "$ext" ] && gnome-extensions disable "$ext" 2>/dev/null
    [ "$ext" = "$POP" ] && { echo "Removing needs sudo:"
                             sudo apt remove -y gnome-shell-extension-pop-shell; }
    [ "$ext" = "$FORGE" ] && { gnome-extensions uninstall "$FORGE" 2>/dev/null
                               echo "Forge removed."; }
    exit 0 ;;
esac

if ! on_gnome; then
    echo
    if gnome_installed; then
        echo "  GNOME is INSTALLED but is not RUNNING right now."
        echo
        echo "  Tiling arranges a live desktop, so there is nothing for"
        echo "  it to do until you are looking at one. Either plug the"
        echo "  panel in and log in, or make the VNC session start GNOME"
        echo "  instead of a bare X session -- what it starts now is set"
        echo "  in ~/.vnc/xstartup"
        echo
        echo "  Nothing was installed or changed."
    else
        echo "  This board is not running GNOME, and tiling here is a"
        echo "  GNOME extension. A bare X session has no shell to put"
        echo "  one in."
    fi
    echo
    exit 1
fi

if ! have "$POP" && ! have "$FORGE"; then
    echo
    echo "  Looking for Pop Shell in apt..."
    if sudo apt install -y gnome-shell-extension-pop-shell 2>/dev/null; then
        :
    else
        echo
        echo "  Not packaged on this Ubuntu. Installing Forge instead --"
        echo "  same job, and it downloads without opening a browser."
        echo
        # extensions.gnome.org names the right zip for THIS shell
        # version. Guessing a URL breaks the day GNOME updates; asking
        # does not. Stdlib python3 only, like the rest of this project.
        if ! python3 - "$FORGE" <<'PY'
import json, re, subprocess, sys, tempfile, urllib.request, os
uuid = sys.argv[1]
ver = subprocess.run(["gnome-shell", "--version"], capture_output=True,
                     text=True).stdout
major = re.search(r"(\d+)", ver).group(1)
api = ("https://extensions.gnome.org/extension-info/?uuid=%s&shell_version=%s"
       % (uuid, major))
info = json.load(urllib.request.urlopen(api, timeout=25))
url = "https://extensions.gnome.org" + info["download_url"]
zip_path = os.path.join(tempfile.gettempdir(), "forge.zip")
with open(zip_path, "wb") as fh:
    fh.write(urllib.request.urlopen(url, timeout=60).read())
subprocess.run(["gnome-extensions", "install", "--force", zip_path],
               check=True)
print("  Forge downloaded and installed.")
PY
        then
            echo
            echo "  Could not fetch Forge. If this board just booted its"
            echo "  clock starts at 1969 and TLS fails until NTP lands --"
            echo "  wait thirty seconds and run this again."
            echo
            exit 1
        fi
    fi
fi

ext=$(which_ext)
if [ -z "$ext" ] || ! gnome-extensions enable "$ext" 2>/dev/null; then
    echo
    echo "  Installed, but GNOME has not picked it up yet."
    echo "  In the desktop press Alt+F2, type  r , press Enter."
    echo "  Then run  ~/YUZU/tile  again."
    echo
    exit 1
fi

# A few pixels of breathing room, but only a few. On 1024x600 every
# pixel of gap is a pixel of Kiwix.
if [ "$ext" = "$POP" ]; then
    gsettings set org.gnome.shell.extensions.pop-shell gap-inner 2 2>/dev/null
    gsettings set org.gnome.shell.extensions.pop-shell gap-outer 2 2>/dev/null
    gsettings set org.gnome.shell.extensions.pop-shell tile-by-default true 2>/dev/null
fi

say_state
