#!/bin/bash
# Pair the controller. One word, no interactive bluetoothctl.
#
#   ~/YUZU/pad          find, pair, trust and connect an 8BitDo
#   ~/YUZU/pad --forget drop the pairing and start clean
#   ~/YUZU/pad --status is it connected right now
#
# bluetoothctl is a REPL: type scan on, wait, read a wall of MAC
# addresses, type pair <mac>, agree to something. That is a bad time on
# a phone keyboard over a serial link, and it is entirely scriptable.

set -u
WANT="${PAD_NAME:-8bitdo}"          # override for a different brand
SCAN_SECS=15

mac_of() {
    bluetoothctl devices 2>/dev/null \
        | grep -i -- "$WANT" | head -1 | awk '{print $2}'
}

connected() {
    bluetoothctl info "$1" 2>/dev/null | grep -q "Connected: yes"
}

# PAIRED IS NOT BONDED, and only bonding gets you a gamepad.
#
# Measured Sept 9. The pad paired, trusted and connected, and BlueZ
# then refused the only part that matters:
#
#   hidp_add_connection() Rejected connection from !bonded device
#   ...
#   input-hid state changed: connecting -> connected (0)
#   device_profile_connected() input-hid Success (0)
#
# It logs Success immediately after the rejection, so every layer above
# reports a working controller. `Bonded: no` in `bluetoothctl info` is
# the only field that tells the truth.
bonded() {
    bluetoothctl info "$1" 2>/dev/null | grep -q "Bonded: yes"
}

# SDL (what mGBA uses) reads evdev, so the honest check is whether the
# kernel actually created an input device -- not whether Bluetooth says
# "connected". Those come apart: a pad can be linked at the BT layer
# and still expose no gamepad, which looks identical from bluetoothctl.
has_input_node() {
    grep -i -- "$WANT" /proc/bus/input/devices >/dev/null 2>&1
}

case "${1:-}" in
--status)
    MAC=$(mac_of)
    [ -z "$MAC" ] && { echo "No $WANT controller is paired yet."; exit 1; }
    echo "Paired:     $MAC"
    connected "$MAC" && echo "Bluetooth:  connected" \
                     || echo "Bluetooth:  NOT connected"
    bonded "$MAC" && echo "Bonded:     yes" \
                  || echo "Bonded:     NO -- BlueZ will refuse the gamepad"
    has_input_node && echo "Gamepad:    visible to games" \
                   || echo "Gamepad:    NOT visible -- games will not see it"
    exit 0
    ;;
--forget)
    MAC=$(mac_of)
    [ -z "$MAC" ] && { echo "Nothing to forget."; exit 0; }
    bluetoothctl remove "$MAC" >/dev/null 2>&1
    echo "Forgot $MAC. Run ~/YUZU/pad to pair again."
    exit 0
    ;;
esac

echo
echo "  Put the controller in pairing mode:"
echo "    1. Hold  START + A   for a second  (D-input mode, what Linux wants)"
echo "    2. Then hold  SELECT  ~3s until the light flashes fast"
echo
read -r -p "  Light flashing? Press Enter to search. " _

bluetoothctl power on >/dev/null 2>&1

MAC=$(mac_of)
if [ -z "$MAC" ]; then
    echo "  Searching ${SCAN_SECS}s..."
    bluetoothctl --timeout $SCAN_SECS scan on >/dev/null 2>&1
    MAC=$(mac_of)
fi

if [ -z "$MAC" ]; then
    echo
    echo "  No '$WANT' device found. Usually one of:"
    echo "    - the light is not FLASHING (solid = on but not pairing)"
    echo "    - it reconnected to your phone or a Switch instead"
    echo "    - it is in the wrong mode; try START + B (Switch mode)"
    echo
    echo "  Everything the board can currently see:"
    bluetoothctl devices | sed 's/^/    /' || echo "    nothing"
    exit 1
fi

echo "  Found $MAC"

# ONE bluetoothctl session, not three commands.
#
# `bluetoothctl pair` as a one-shot registers an agent, pairs, and
# EXITS -- and the agent dies with it, so bonding never completes. You
# get Paired: yes, Bonded: no, and a controller no game can see. Piping
# the whole sequence keeps a single session (and its agent) alive from
# `agent on` through `connect`.
bluetoothctl >/tmp/pad-pair.log 2>&1 <<BT
power on
agent NoInputNoOutput
default-agent
pair $MAC
trust $MAC
connect $MAC
BT
sleep 3

# A half-pairing cannot be repaired in place -- BlueZ keeps the bad
# state until the device is removed entirely.
if ! bonded "$MAC"; then
    echo "  Paired but not bonded. Clearing and retrying once..."
    bluetoothctl remove "$MAC" >/dev/null 2>&1
    sleep 1
    bluetoothctl --timeout $SCAN_SECS scan on >/dev/null 2>&1
    MAC=$(mac_of)
    [ -z "$MAC" ] && { echo "  Lost it. Put it back in pairing mode and rerun."
                       exit 1; }
    bluetoothctl >>/tmp/pad-pair.log 2>&1 <<BT
power on
agent NoInputNoOutput
default-agent
pair $MAC
trust $MAC
connect $MAC
BT
    sleep 3
fi

echo
if ! bonded "$MAC"; then
    echo "  Still NOT BONDED, which is why no gamepad appears."
    echo "  BlueZ logs it as: Rejected connection from !bonded device"
    echo
    echo "  Make sure the light is FLASHING (pairing), not solid"
    echo "  (already-on). A trusted pad reconnects without ever bonding."
    echo "    ~/YUZU/pad --forget    then hold SELECT ~3s, then rerun"
    exit 1
fi

if connected "$MAC"; then
    echo "  Connected, and trusted -- it will reconnect on its own from now on."
else
    echo "  Paired but not connected. Try once more:  ~/YUZU/pad"
    exit 1
fi

if has_input_node; then
    echo "  The kernel sees it as a gamepad."
    echo
    echo "  Last step, inside mGBA (in AVNC):"
    echo "    Tools -> Settings -> Controllers, click each box, press that button."
else
    echo "  Bonded and connected, but NO gamepad device appeared yet."
    echo "  Sometimes the kernel needs a moment. Check again with:"
    echo "    ~/YUZU/pad --status"
    echo "  If it stays missing:  ~/YUZU/pad --forget   and pair once more"
    echo "  with the light FLASHING."
fi
echo
