#!/bin/bash
# Show her face. One word.
#
#   ~/YUZU/face           serve it, print the address for the phone
#   ~/YUZU/face --off     stop
#   ~/YUZU/face --status  is it up, and can the phone reach it
#   ~/YUZU/face --boot    start it at every boot, with no screen attached
#   ~/YUZU/face --boot --off    stop doing that
#
# The PHONE is the screen here, not the deck. It is a touchscreen
# already, the face is built for touch, and it needs no VNC, no X
# session and no browser installed on the board. When the real 7" panel
# lands the same page opens locally instead -- nothing changes but the
# client.

set -u
# Overridable so the suite can drive the REAL script on a free port.
# 8080 is kiwix, 8000 is drop.py.
PORT=${YUZU_FACE_PORT:-8081}
DIR="$(cd "$(dirname "$0")" && pwd)/ui"
LOG=/tmp/face.log

# The LAN address, or empty. NEVER a placeholder string: a caller has to
# be able to tell "no network" from "here is the address", and a
# sentence dressed up as an IP defeats that. `ip route get` is the one
# that picks the address the phone will actually arrive on -- reading
# the first line of `hostname -I` has cost this project time three
# times (docker0 and the USB-gadget link both sort ahead of the real
# one), so that is the FALLBACK and it is filtered.
lan_ip() {
    local found
    found=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K\S+' | head -1)
    if [ -z "$found" ]; then
        found=$(hostname -I 2>/dev/null | tr ' ' '\n' \
                | grep -v '^127\.' | grep -v '^172\.1[6-9]\.' \
                | grep -v '^172\.2[0-9]\.' | grep -v '^172\.3[01]\.' \
                | grep -v '^192\.168\.55\.' | head -1)
    fi
    echo "$found"
}

# TWO QUESTIONS, ASKED SEPARATELY, because they have different answers
# and different fixes:
#
#   up()         is the server running at all?      (loopback)
#   reachable()  can the PHONE get to it?           (LAN address)
#
# The first version asked only the second, so on a board with no network
# it reported "it did not come up" about a server that was serving
# perfectly. That is this project's most-repeated bug -- a check that
# cannot observe the actual failure mode -- and merging the two
# questions is how you build one.
#
# Both CONNECT rather than reading a listener table. `ss` is not
# guaranteed (it was missing on a machine this was developed against),
# and connecting is exactly what the phone does. python3 is guaranteed:
# it is the whole project's one rule.
_connect() {
    [ -n "$1" ] || return 1
    python3 -c "
import socket, sys
s = socket.socket(); s.settimeout(1.5)
try:
    s.connect((sys.argv[1], int(sys.argv[2])))
except Exception:
    sys.exit(1)
finally:
    s.close()
" "$1" "$PORT" 2>/dev/null
}

up()        { _connect 127.0.0.1; }
reachable() { _connect "$(lan_ip)"; }

# The verdict goes FIRST. `pad --status` printed two alarming lines
# about a transport that was not in use and the answer last, and a
# working controller read as broken.
report() {
    local ip; ip=$(lan_ip)
    echo
    if ! up; then
        echo "  NOT RUNNING.  Start it with:  ~/YUZU/face"
        echo
        return 1
    fi
    if [ -z "$ip" ]; then
        echo "  RUNNING -- but this board is not on the network,"
        echo "  so the phone cannot reach it. Connect WiFi, then re-run."
        echo
        echo "  On the deck's own screen it works now:"
        echo "      http://127.0.0.1:$PORT/"
        echo
        return 0
    fi
    if ! reachable; then
        echo "  RUNNING -- but not answering on $ip, so the phone"
        echo "  cannot reach it. Something is filtering the port."
        echo
        return 1
    fi
    echo "  UP.  Open this on your phone:"
    echo "      http://$ip:$PORT/"
    # AND A NAME, because an address he has to re-read off a serial
    # terminal is an address he needs a cable to learn. mDNS gives the
    # board a name that follows it across DHCP leases, so this is the
    # one worth bookmarking. It is NOT promised: whether avahi answers
    # on his board is not checkable from here, and a stated fact that
    # turns out false costs more than an untried suggestion. He will
    # know in ten seconds.
    # `hostname` WITH NO ARGUMENT IS NOT A NAME on every box, and the
    # suite caught this within a minute: its stub returns the decoy list
    # this script exists to filter, so the first draft told him to open
    # "http://172.17.0.1 192.168.55.1 192.0.2.2.local" -- the docker
    # bridge, inside an address, in the one line meant to save him a
    # cable. Fourth time that address has cost this project something.
    #
    # `-s` is the short name, and it is REFUSED unless it looks like a
    # hostname and nothing else. Absent rather than wrong: a suggestion
    # he cannot use is worse than no suggestion.
    local name; name=$(hostname -s 2>/dev/null)
    case "$name" in
        # A NAME CAN BE PERFECTLY VALID AND STILL BE USELESS TO HIM, and
        # this is the second mistake in that line in one hour. The first
        # guard asked "is this a syntactically legal hostname" when the
        # question is "will this reach THIS board from ANOTHER device".
        # `localhost` passes the first and fails the second absolutely:
        # it means *the machine asking*, so his board -- which really is
        # named localhost -- told his phone to open ITSELF.
        #
        # Measured, on his phone: DNS_PROBE_FINISHED_NXDOMAIN on
        # http://localhost.local:8081/. A check that cannot observe the
        # actual failure is not a check, which is the oldest line in
        # CLAUDE.md, and I wrote one an hour after quoting it.
        localhost|localhost.*|*[!A-Za-z0-9-]*|"") name="" ;;
    esac
    if [ -n "$name" ]; then
        echo
        echo "  Or try this, which survives the address changing:"
        echo "      http://$name.local:$PORT/"
        echo "  (mDNS. If it does not load, use the numbers above.)"
    fi
    echo
    echo "  That is the HOME SCREEN, not her face. Ghost, Sept 12:"
    echo "  \"id like to choose what i wana do before sayas face pops"
    echo "  up 1st\" -- so the address with nothing after it lands on"
    echo "  the deck, and A.I. is where the characters live."
    echo
    echo "  New face for Saya: drop a transparent PNG in"
    echo "  ~/YUZU/ui/sprites/ and reload."
    echo "  Stop it with:  ~/YUZU/face --off"
    echo
    return 0
}

# --- start at every boot, with NO SCREEN ATTACHED ----------------------
# Ghost, Sept 15: "She gotta be powered on then do what to use just my
# phone?? ... Idk how to use my phone wirelessly with it."
#
# THE ANSWER WAS "PLUG IN THE CABLE FIRST", AND THAT IS THE GAP.
# `deckapps --autostart` starts this server, but it does it from a
# .desktop file in ~/.config/autostart -- which runs when a DESKTOP
# SESSION LOGS IN. The Nano has no screen on it, so nothing logs in,
# so nothing serves, so the phone has nothing to reach. The one thing
# standing between him and a cable-free deck was a login that never
# happens.
#
# A systemd service does not care whether anyone is looking at the
# board. Power on, WiFi up, she answers.
#
# SEPARATE FROM `--off`, deliberately, and the same reason `tile` keeps
# --off and --remove apart: the cheap "stop it now" must never be the
# word that also tears the install out.
if [ "${1:-}" = "--boot" ]; then
    unit=/etc/systemd/system/yuzu-face.service
    me="$(cd "$(dirname "$0")" && pwd)"
    if [ "${2:-}" = "--off" ]; then
        sudo systemctl disable --now yuzu-face.service 2>/dev/null
        sudo rm -f "$unit"
        sudo systemctl daemon-reload 2>/dev/null
        echo
        echo "  It will no longer start at boot. It is still installed;"
        echo "  run ~/YUZU/face to start it by hand."
        echo
        exit 0
    fi
    echo
    echo "  Installing a boot service. This needs sudo once."
    echo
    sudo tee "$unit" >/dev/null <<UNIT
[Unit]
Description=YUZU face server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$(id -un)
WorkingDirectory=$me
ExecStart=/usr/bin/python3 $me/yuzu_face.py --serve --port $PORT
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
    sudo systemctl daemon-reload || exit 1
    sudo systemctl enable --now yuzu-face.service || exit 1
    sleep 2
    # VERIFY, never assume. This project has reported a dead thing as
    # working and a working thing as dead, both, and the fix both times
    # was to go and look.
    if up; then
        echo "  DONE. She is serving now and will serve at every boot,"
        echo "  with no screen and nobody logged in."
        report
    else
        echo "  INSTALLED, but she did not come up. Its own output:"
        sudo systemctl status yuzu-face.service --no-pager -l 2>&1 \
            | tail -12 | sed 's/^/    /'
        echo
        exit 1
    fi
    exit 0
fi

case "${1:-}" in
--off)
    pkill -f "yuzu_face.py --serve --port $PORT" 2>/dev/null && echo "Face stopped." \
                                             || echo "It was not running."
    exit 0 ;;
--status)
    report; exit $? ;;
esac

# THE LANDING PAGE IS home.html, so that is what has to exist for the
# address he types to work. face.html is checked too because Saya is
# still one tap away and an icon that opens nothing reads as a broken
# deck rather than a missing file.
for page in home.html face.html; do
    [ -f "$DIR/$page" ] || {
        echo "No $DIR/$page -- run: ~/YUZU/pull"; exit 1; }
done

# THERE IS NO BUILD STEP. A sprite dropped in ui/sprites/ five seconds
# ago is live on the next page refresh -- the manifest is generated per
# request and the page colours her line art itself with CSS. The mouth
# paint that used to be generated here is gone: "Revert back to strictly
# lineart on a colored background."

if ! up; then
    # nohup + & always. A foreground server on a serial link reads as a
    # frozen board, and that has already cost this project two power
    # cycles. --bind 0.0.0.0 because the phone is the client.
    # yuzu_face.py rather than `python3 -m http.server`: it serves ui/
    # AND generates /sprites.json per request, so dropping a new PNG in
    # ui/sprites/ needs a page refresh instead of a server restart. On
    # a phone over a serial link that is a much bigger difference than
    # it sounds.
    nohup python3 "$(dirname "$DIR")/yuzu_face.py" --serve --port "$PORT" \
        >"$LOG" 2>&1 &
    sleep 2
    if ! up; then
        echo; echo "  It did not come up. Its own output:"
        tail -5 "$LOG" | sed 's/^/    /'; echo; exit 1
    fi
fi

report
