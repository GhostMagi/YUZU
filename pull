#!/bin/bash
# Get the latest, and SAY whether it worked.
#
#   ~/YUZU/pull
#
# WHY THIS EXISTS. Sept 10, four seconds after logging in:
#
#   fatal: unable to access 'https://github.com/GhostMagi/YUZU.git/':
#   server certificate verification failed. CAfile: none CRLfile: none
#
# Then he ran `face`, got the OLD art, and asked why the new faces had
# not arrived. They had not arrived because THE PULL FAILED -- but the
# failure scrolled past above a wall of Ubuntu login banner, and the
# next command printed a cheerful "UP. Open this on your phone."
#
# **The Orin Nano devkit ships with no RTC battery.** Every boot starts
# at the epoch and stays there until NTP reaches the network, and a
# certificate cannot be valid before it was issued. The window where
# that is true is the first minute of uptime -- exactly when someone who
# just booted the board is typing. CLAUDE.md carried this as a theory
# for a day; this is the confirmation.
#
# So: wait for the clock, retry, and put the VERDICT FIRST. A failed
# update that looks like a successful one costs him a whole session
# wondering why nothing changed.

set -u
# Absolute, computed BEFORE the cd, because the re-exec below has to be
# able to name this file however it was invoked.
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$self")" || exit 1

# Set by the run that exec'd us, and it carries the commit that run
# started from. Empty on an ordinary pull. It is also the loop guard:
# a re-exec never re-execs.
reexec="${YUZU_PULL_REEXEC:-}"

# --- wait for the clock ------------------------------------------------
# Not a sleep: it watches, tells him why, and gives up saying something
# useful rather than hanging forever on a board with no network.
year=$(date +%Y)
if [ "$year" -lt 2020 ]; then
    echo
    echo "  This board thinks it is $year -- it has no clock battery and"
    echo "  has not reached the network yet. HTTPS cannot work until it"
    echo "  does. Waiting..."
    for _ in $(seq 1 24); do
        sleep 5
        year=$(date +%Y)
        [ "$year" -ge 2020 ] && break
    done
    if [ "$year" -lt 2020 ]; then
        echo
        echo "  Still $year after two minutes, so this board is not on"
        echo "  the network at all. Check WiFi, then run this again."
        echo
        exit 1
    fi
    echo "  Clock is set. Carrying on."
fi

# --- pull, with retries ------------------------------------------------
if [ -n "$reexec" ]; then
    # The run that exec'd us already pulled. It handed over the commit it
    # started from, so the verdict below is about the REAL update rather
    # than about a second no-op pull we are not going to run.
    before="$reexec"
    after=$(git rev-parse HEAD 2>/dev/null)
    ok=1
    out=""
else
    before=$(git rev-parse HEAD 2>/dev/null)
    # Overridable so the SUITE does not sit through 14 seconds of backoff
    # three times over. The default is what he actually gets.
    WAITS=${YUZU_PULL_WAITS:-"0 2 4 8"}
    out=""; ok=0
    for wait in $WAITS; do
        [ "$wait" -gt 0 ] && sleep "$wait"
        out=$(git pull origin main 2>&1) && { ok=1; break; }
        echo "  retrying..."
    done
    after=$(git rev-parse HEAD 2>/dev/null)
fi

# --- THE PULL THAT DELIVERS A CHANGE TO THIS SCRIPT RAN THE OLD COPY ---
# MEASURED, Sept 16, on his screen. He pulled the round that added the
# voice setup and the Welcome line, the output said UPDATED and listed
# the very commit that added them -- and then printed the OLD tail, with
# neither of the new things in it.
#
# Nothing was broken and he read it exactly right. Bash had this file
# OPEN before `git pull` replaced it underneath, so the run that brought
# the change is the one run that cannot contain it. Same shape as the
# `~/YUZU/name` "No such file or directory" a day earlier: the work
# landed, one run late, and the failure looks like the work not landing.
#
# AND IT IS WORSE THAN A DELAY, which is why this is a fix and not a
# note. Verified by replacing a running script mid-execution: bash
# re-reads the NEW file at the byte offset it had reached in the OLD
# one, so it executes a FRAGMENT of the new script spliced onto the old
# run. That is undefined behaviour, not a late delivery.
#
# So: re-run the new self, once, carrying the commit we started from so
# the verdict stays true. `reexec` is the loop guard -- it is set here
# and checked above, so this can happen at most once per pull. And it is
# announced, because if the new copy is broken, a SILENT exec would give
# him an empty pull with nothing to read.
if [ -z "$reexec" ] && [ "$ok" = 1 ] && [ "$before" != "$after" ] \
   && [ -r "$self" ] \
   && git diff --name-only "$before" "$after" 2>/dev/null | grep -qx pull; then
    echo
    echo "  THIS SCRIPT UPDATED ITSELF. Running the new one, so the"
    echo "  changes land now rather than on your next pull."
    YUZU_PULL_REEXEC="$before" exec bash "$self" "$@"
fi

# --- the verdict, FIRST ------------------------------------------------
echo
if [ "$ok" = 0 ]; then
    echo "  PULL FAILED. Nothing was updated."
    echo
    echo "$out" | sed 's/^/    /' | tail -6
    echo
    case "$out" in
        *certificate*) echo "  That is the clock again. Wait a minute and retry." ;;
        *"Could not resolve"*|*"unable to access"*)
            echo "  The board cannot reach GitHub. Check WiFi." ;;
        *conflict*|*"local changes"*)
            echo "  You have edits on the board that would be overwritten."
            echo "  Nothing was touched. Ask before forcing anything." ;;
    esac
    echo
    exit 1
fi

if [ "$before" = "$after" ]; then
    echo "  ALREADY UP TO DATE. Nothing changed."
else
    echo "  UPDATED."
    echo
    git log --oneline "$before..$after" 2>/dev/null | head -6 | sed 's/^/    /'
    files=$(git diff --name-only "$before" "$after" 2>/dev/null)
    echo
    echo "    $(printf '%s\n' "$files" | grep -c .) files changed."
    # Her art is the thing he notices, so name it when it moved.
    if printf '%s\n' "$files" | grep -q '^ui/sprites/'; then
        echo "    HER FACE CHANGED -- reload the page, do not just look at it."
    fi

    # AND NAME A COMMAND THAT DID NOT EXIST BEFORE. Measured, Sept 15:
    # he was told to run `~/YUZU/name ghostnano`, had pulled ten minutes
    # earlier, and got "No such file or directory" -- twice, because the
    # obvious next guess is that you are in the wrong directory. Nothing
    # was wrong; the script simply landed after his pull.
    #
    # A new FILE is invisible in "37 files changed". A new COMMAND is a
    # thing he is about to type, so it gets its own line -- same reason
    # the sprites line above exists, one layer over.
    new=$(git diff --name-only --diff-filter=A "$before" "$after" 2>/dev/null \
          | grep -v '/' | while read -r f; do
              [ -x "$f" ] && [ ! -f "$f.py" ] && case "$f" in
                  *.*) ;; *) printf ' ~/YUZU/%s' "$f" ;;
              esac
          done)
    if [ -n "$new" ]; then
        echo "    NEW COMMAND:$new"
    fi

    # --- A RUNNING SERVER GOES ON SERVING THE OLD CODE ----------------
    # MEASURED, Sept 15, and it looked exactly like a feature that had
    # not arrived. Ghost pulled the round that added Four, opened the
    # deck, and got ONE full-width ☆Stuff☆ tile with no character on it
    # -- which is the page's own honest fallback for "the roster has no
    # front character in it".
    #
    # Both halves were true at once and that is the trap. The PAGE is a
    # file, re-read from disk on every request, so home.html was the new
    # one. /characters.json comes out of a PYTHON PROCESS that has been
    # running since before the pull, so the roster was the old one --
    # no Four, no `front` flag. Fresh markup, stale data, and the deck
    # renders as though the work never landed.
    #
    # Reproduced here by serving the new page from a server with the old
    # roster: pixel for pixel his screenshot.
    #
    # `face` re-reads ui/ per request but NOT its own module, so this
    # is not fixable inside the server. It is fixable here, where we
    # already know what changed -- and restarting only when the server
    # is ALREADY UP, because starting one he never asked for is its own
    # surprise. Same rule as everything else on this deck: the thing
    # that knows should act, not report.
    #
    # SUPPRESSED WHEN THE SERVER ITSELF IS THE CALLER. `POST /pull` runs
    # this script from inside yuzu_face.py, and a restart there would
    # pkill the process that is holding the open request -- he taps Pull
    # and gets a network error over an update that worked perfectly.
    # Same ordering drop.py had to learn: the reply goes out FIRST. The
    # server restarts itself afterwards, from a detached child.
    if [ "${YUZU_PULL_NO_RESTART:-}" = 1 ]; then
        :
    elif printf '%s\n' "$files" | grep -q '^[^/]*\.py$'; then
        if pgrep -f "yuzu_face.py --serve" >/dev/null 2>&1; then
            # QUIET WHEN IT WORKS, LOUD WHEN IT DOES NOT. Ghost, Sept
            # 16, with the wall of face's own startup banner sitting
            # between his pull and the Welcome line: "All that is
            # unnecessary... just a buncha changes i already know
            # happened." He asked for two lines at the end and got
            # twenty, because a restart printed the address twice, the
            # HOME SCREEN paragraph and the sprite note into a pull.
            #
            # None of that is news here -- he did not ask for a server,
            # he asked for an update, and the address is printed by the
            # welcome two inches below anyway. So it is CAPTURED, and
            # printed only when `face` fails: a server that did not come
            # back is the one thing in there worth his attention, and
            # swallowing that would be the silent-failure shape this
            # file refuses everywhere else.
            ./face --off >/dev/null 2>&1
            if said=$(./face 2>&1); then
                echo "    THE FACE SERVER WAS RUNNING THE OLD CODE."
                echo "    Restarted it, so what answers is what you"
                echo "    just pulled."
            else
                echo "    THE FACE SERVER WAS RUNNING THE OLD CODE and"
                echo "    did not come back. Its own output:"
                printf '%s\n' "$said" | tail -6 | sed 's/^/    /'
            fi
        fi
    fi
fi

# --- HER VOICE, ONCE, WITHOUT A SECOND COMMAND TO REMEMBER --------
# OUTSIDE the up-to-date branch on purpose. He asked to type pull
# and have her work -- so a pull that brings nothing new must still
# fix a voice she does not have, or the one word does not do what
# he was told it does.
# Ghost, Sept 16: "Plz dont add new commands i cant actually
# remember any except /wiki. Just help me simply get this goin".
#
# He is right and the first draft was wrong. A `~/YUZU/voice` script
# was the tidy answer and it is a THIRD thing to remember on a board
# whose only shell is a serial cable -- this file already records
# that a new command needs its own line precisely because a new
# command is a cost. The cheapest command is the one he already
# types.
#
# THIS RUNS ONCE AND THEN NEVER AGAIN. It asks the same function the
# page asks -- can she speak RIGHT NOW -- so there is no second copy
# of "is the voice installed" to drift. Once she can, this block
# costs one python call and prints nothing.
#
# IT SAYS THE SIZE BEFORE IT SPENDS IT. ~340MB onto a board he pulls
# over WiFi is real, and a script that quietly spends it is the
# surprise this project keeps refusing to ship. But he ASKED for
# one word, so it is announced rather than withheld.
#
# AND IT CAN ONLY EVER COST THE VOICE. Every failure path below
# leaves the pull successful and her talking exactly as before --
# the promise the face, the wiki and Piper all make.
if ! python3 -c "import yuzu_voice,sys; sys.exit(0 if yuzu_voice.pick_voice().ready else 1)" 2>/dev/null; then
    echo
    echo "    SHE HAS NO VOICE YET. Setting one up -- about 340MB,"
    echo "    once, and never again. Piper still works if this fails."
    echo
    pip install --quiet kokoro-onnx soundfile 2>&1 | tail -2
    if python3 -c "import kokoro_onnx" 2>/dev/null; then
        mkdir -p voices
        # The filenames come from the RELEASE, never from memory.
        # Unverified specifics stated as steps already cost this
        # project an hour on the 8BitDo, and a release renames its
        # assets whenever it likes.
        for url in $(python3 - <<'ASK'
import json, urllib.request
try:
with urllib.request.urlopen(
        "https://api.github.com/repos/thewh1teagle/kokoro-onnx/releases",
        timeout=25) as r:
    releases = json.load(r)
except Exception:
raise SystemExit
for rel in releases:
names = {a["name"]: a["browser_download_url"] for a in rel.get("assets", [])}
model = [n for n in names if n.endswith(".onnx")]
binp = [n for n in names if n.endswith(".bin")]
# BOTH or neither: half a download reports success and then cannot
# speak, which is worse than a clean failure.
if model and binp:
    print(names[sorted(model)[-1]])
    print(names[sorted(binp)[-1]])
    break
ASK
        ); do
            name="voices/$(basename "$url")"
            [ -s "$name" ] && continue
            echo "    fetching $(basename "$url")"
            # --fail so a 404 is a failure rather than an HTML error
            # page saved as a model; .part so nothing half-written
            # is ever kept.
            curl -fL --progress-bar -o "$name.part" "$url" \
                && mv "$name.part" "$name" || rm -f "$name.part"
        done
    fi
    if python3 -c "import yuzu_voice,sys; sys.exit(0 if yuzu_voice.pick_voice().ready else 1)" 2>/dev/null; then
        echo "    SHE TALKS NOW. Open her page and say something."
    else
        echo "    Could not set the new voice up here -- she still"
        echo "    talks, just in the old one. Nothing is broken."
    fi
    echo
fi
# --- WHERE SHE IS, EVERY TIME ---------------------------------------
# Ghost: "have it show the http://ghostnano.local:8081/ bit right under
# that. Thats it tho. Just Welcome Ghost, (url here)".
#
# THE NAME IS READ, NEVER HARDCODED. `ghostnano` is what his board is
# called TODAY -- he renamed it himself an hour after the deck shipped
# -- and a hardcoded hostname goes stale the next time he renames it,
# with the failure looking like the deck working. Same fault as the
# hardcoded cast in home.html, one layer down.
#
# AND IT CARRIES THE SAME REFUSAL `face` LEARNED THE HARD WAY.
# `localhost` is a perfectly legal hostname and means THE MACHINE
# ASKING, so a board really named that told his phone to open ITSELF --
# measured, DNS_PROBE_FINISHED_NXDOMAIN, on his screen. Refused here
# too, and the LAN address answers instead: absent rather than wrong.
name=$(hostname -s 2>/dev/null)
case "$name" in
    localhost|localhost.*|*[!A-Za-z0-9-]*|"") name="" ;;
esac
if [ -n "$name" ]; then
    url="http://$name.local:8081/"
else
    # The routing-table address, never the first line of `hostname -I`
    # -- docker's 172.17.0.1 and the USB-gadget link 192.168.55.1 both
    # sort ahead of the real one, and picking the first has cost this
    # project time four times.
    ip=$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
    [ -n "$ip" ] && url="http://$ip:8081/" || url=""
fi

echo
echo "  Welcome Ghost,"
[ -n "$url" ] && echo "  $url"
echo
